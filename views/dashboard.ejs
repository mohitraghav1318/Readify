<%- include('partials/header') %>

    <div class="container my-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="bi bi-person-circle fs-1 text-primary"></i>
                        </div>
                        <h4>
                            <%= user.fullName %>
                        </h4>
                        <p class="text-muted">
                            <%= user.email %>
                        </p>
                        <hr>
                        <p class="mb-1"><strong>Member since</strong></p>
                        <p class="text-muted">
                            <%= new Date(user.createdAt).toLocaleDateString() %>
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <h2 class="mb-4">
                    <i class="bi bi-book"></i> My Reading List
                </h2>

                <% if (readingBooks && readingBooks.length> 0) { %>
                    <div class="row g-4">
                        <% readingBooks.forEach(userBook=> { %>
                            <div class="col-md-6">
                                <div class="card shadow-sm">
                                    <div class="row g-0">
                                        <div class="col-4">
                                            <img src="<%= userBook.book.coverImage %>" class="img-fluid h-100"
                                                alt="<%= userBook.book.title %>" style="object-fit: cover;">
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body">
                                                <h6 class="card-title">
                                                    <%= userBook.book.title %>
                                                </h6>
                                                <p class="card-text small text-muted">By <%= userBook.book.author %>
                                                </p>
                                                <p class="card-text">
                                                    <span
                                                        class="badge bg-<%= userBook.status === 'reading' ? 'primary' : userBook.status === 'completed' ? 'success' : 'secondary' %>">
                                                        <%= userBook.status %>
                                                    </span>
                                                </p>
                                                <p class="card-text small text-muted">
                                                    Started: <%= new Date(userBook.startedAt).toLocaleDateString() %>
                                                </p>
                                                <a href="/library/book/<%= userBook.book._id %>"
                                                    class="btn btn-sm btn-outline-primary">
                                                    View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="card shadow-sm">
                            <div class="card-body text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                <h4 class="mt-3 text-muted">No books in your reading list yet</h4>
                                <p class="text-muted">Start exploring our library and add books to your reading list</p>
                                <a href="/library" class="btn btn-primary mt-3">
                                    <i class="bi bi-collection"></i> Browse Library
                                </a>
                            </div>
                        </div>
                        <% } %>

                            <div class="mt-5">
                                <h3 class="mb-3">Reading Statistics</h3>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="card bg-primary text-white shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="bi bi-book fs-1"></i>
                                                <h3 class="mt-2">
                                                    <%= readingBooks.length %>
                                                </h3>
                                                <p class="mb-0">Books Reading</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card bg-success text-white shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="bi bi-check-circle fs-1"></i>
                                                <h3 class="mt-2">
                                                    <%= readingBooks.filter(b=> b.status === 'completed').length %>
                                                </h3>
                                                <p class="mb-0">Completed</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card bg-info text-white shadow-sm">
                                            <div class="card-body text-center">
                                                <i class="bi bi-bookmark fs-1"></i>
                                                <h3 class="mt-2">
                                                    <%= readingBooks.filter(b=> b.status === 'wishlist').length %>
                                                </h3>
                                                <p class="mb-0">Wishlist</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
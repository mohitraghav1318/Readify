<%- include('partials/header') %>

    <!-- Hero Section -->
    <div class="hero-section bg-primary text-white py-5">
        <div class="container text-center">
            <h1 class="display-4 fw-bold mb-3">Welcome to Readify</h1>
            <p class="lead mb-4">Discover thousands of books across multiple categories. Start your learning journey
                today!</p>
            <div class="hero-actions">
                <a href="/library" class="btn btn-light btn-lg">
                    <i class="bi bi-collection"></i> Browse Library
                </a>
            </div>
        </div>
    </div>

    <!-- Featured Categories Section -->
    <div class="container my-5">
        <div class="text-center mb-5">
            <h2 class="mb-3">Featured Categories</h2>
            <p class="text-muted">Explore our curated collection of books organized by category</p>
        </div>

        <div class="row g-4">
            <% if (featuredCategories && featuredCategories.length> 0) { %>
                <% featuredCategories.forEach(category=> { %>
                    <div class="col-md-4">
                        <a href="/library/category/<%= category._id %>" class="text-decoration-none">
                            <div class="card category-card h-100 shadow-sm">
                                <img src="<%= category.coverImage %>" class="card-img-top" alt="<%= category.name %>"
                                    style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%= category.name %>
                                    </h5>
                                    <p class="card-text text-muted">
                                        <%= category.description.substring(0, 100) %>...
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <div class="col-12 text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 mb-3"></i>
                                <p class="mb-0">No categories available yet. Check back soon!</p>
                            </div>
                            <% } %>
        </div>

        <!-- View All Button -->
        <% if (featuredCategories && featuredCategories.length> 0) { %>
            <div class="text-center mt-5">
                <a href="/library" class="btn btn-primary btn-lg">
                    <i class="bi bi-grid"></i> View All Categories
                </a>
            </div>
            <% } %>
    </div>

    <!-- Features Section -->
    <div class="bg-light py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="mb-3">Why Choose Readify?</h2>
                <p class="text-muted">Everything you need for your reading journey in one place</p>
            </div>

            <div class="row text-center g-4">
                <!-- Feature 1 -->
                <div class="col-md-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-book-half fs-1 text-primary"></i>
                    </div>
                    <h4 class="mb-3">Vast Collection</h4>
                    <p class="text-muted">Access hundreds of books across multiple categories</p>
                </div>

                <!-- Feature 2 -->
                <div class="col-md-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-person-check fs-1 text-primary"></i>
                    </div>
                    <h4 class="mb-3">Track Progress</h4>
                    <p class="text-muted">Keep track of your reading journey with your personal dashboard</p>
                </div>

                <!-- Feature 3 -->
                <div class="col-md-4">
                    <div class="feature-icon mb-3">
                        <i class="bi bi-chat-dots fs-1 text-primary"></i>
                    </div>
                    <h4 class="mb-3">Engage & Share</h4>
                    <p class="text-muted">Comment and like books, share your thoughts with the community</p>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
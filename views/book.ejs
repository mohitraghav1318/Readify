<%- include('partials/header') %>

    <div class="book-details-page">
        <!-- Animated Background -->
        <div class="details-background">
            <div class="bg-particle"></div>
            <div class="bg-particle"></div>
            <div class="bg-particle"></div>
            <div class="bg-particle"></div>
            <div class="bg-wave wave-1"></div>
            <div class="bg-wave wave-2"></div>
        </div>

        <!-- Breadcrumb Section -->
        <div class="breadcrumb-section">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb custom-breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/library">
                                <i class="bi bi-collection"></i> Library
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="/library/category/<%= book.category._id %>">
                                <%= book.category.name %>
                            </a>
                        </li>
                        <li class="breadcrumb-item active">
                            <%= book.title %>
                        </li>
                    </ol>
                </nav>
            </div>
        </div>

        <div class="container my-5">
            <div class="row g-4">
                <!-- Left Column - Book Cover & Actions -->
                <div class="col-lg-4 col-md-5">
                    <div class="book-sidebar">
                        <!-- 3D Book Cover -->
                        <div class="book-3d-container">
                            <div class="book-3d-scene">
                                <div class="book-3d">
                                    <!-- Back Cover -->
                                    <div class="book-back"></div>

                                    <!-- Spine -->
                                    <div class="book-spine">
                                        <div class="spine-text">
                                            <%= book.title %>
                                        </div>
                                    </div>

                                    <!-- Front Cover -->
                                    <div class="book-front">
                                        <div class="cover-texture"></div>
                                        <div class="cover-design">
                                            <div class="cover-header">
                                                <div class="decorative-line"></div>
                                            </div>
                                            <div class="cover-main">
                                                <h2 class="cover-title">
                                                    <%= book.title %>
                                                </h2>
                                                <div class="cover-ornament">
                                                    <i class="bi bi-book"></i>
                                                </div>
                                                <p class="cover-author">
                                                    <%= book.author %>
                                                </p>
                                            </div>
                                            <div class="cover-footer">
                                                <div class="decorative-line"></div>
                                                <span class="category-label">
                                                    <%= book.category.name %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="cover-shine"></div>
                                    </div>

                                    <!-- Top -->
                                    <div class="book-top"></div>

                                    <!-- Bottom -->
                                    <div class="book-bottom"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons">
                            <% if (isAuthenticated) { %>
                                <form method="POST" action="/library/book/<%= book._id %>/add-to-reading">
                                    <button type="submit" class="btn-action <%= isReading ? 'btn-added' : 'btn-add' %>">
                                        <i class="bi <%= isReading ? 'bi-check-circle-fill' : 'bi-plus-circle' %>"></i>
                                        <span>
                                            <%= isReading ? 'In My Library' : 'Add to My Library' %>
                                        </span>
                                    </button>
                                </form>

                                <form method="POST" action="/library/book/<%= book._id %>/like">
                                    <button type="submit" class="btn-action <%= isLiked ? 'btn-liked' : 'btn-like' %>">
                                        <i class="bi bi-heart<%= isLiked ? '-fill' : '' %>"></i>
                                        <span>
                                            <%= isLiked ? 'Unlike' : 'Like' %>
                                        </span>
                                        <span class="like-count">(<%= book.likes %>)</span>
                                    </button>
                                </form>

                                <a href="/library/book/<%= book._id %>/read" class="btn-action btn-read">
                                    <i class="bi bi-book-half"></i>
                                    <span>Read Now</span>
                                </a>
                                <% } else { %>
                                    <a href="/login" class="btn-action btn-login">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                        <span>Login to Add to Library</span>
                                    </a>
                                    <% } %>
                        </div>

                        <!-- Book Stats -->
                        <div class="book-stats-card">
                            <h6 class="stats-title">Book Statistics</h6>
                            <div class="stat-item">
                                <i class="bi bi-heart-fill"></i>
                                <span>
                                    <%= book.likes %> Likes
                                </span>
                            </div>
                            <div class="stat-item">
                                <i class="bi bi-chat-dots-fill"></i>
                                <span>
                                    <%= comments.length %> Comments
                                </span>
                            </div>
                            <div class="stat-item">
                                <i class="bi bi-bookmark-fill"></i>
                                <span>
                                    <%= book.category.name %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Book Details -->
                <div class="col-lg-8 col-md-7">
                    <div class="book-details-content">
                        <!-- Book Header -->
                        <div class="book-header">
                            <h1 class="book-title-main">
                                <%= book.title %>
                            </h1>
                            <p class="book-author">
                                <i class="bi bi-person-circle"></i>
                                By <strong>
                                    <%= book.author %>
                                </strong>
                            </p>

                            <div class="book-badges">
                                <span class="custom-badge category-badge">
                                    <i class="bi bi-tag-fill"></i>
                                    <%= book.category.name %>
                                </span>
                                <span class="custom-badge likes-badge">
                                    <i class="bi bi-heart-fill"></i>
                                    <%= book.likes %> likes
                                </span>
                            </div>
                        </div>

                        <!-- Book Description -->
                        <div class="book-description-section">
                            <h5 class="section-heading">
                                <i class="bi bi-book"></i>
                                Description
                            </h5>
                            <p class="book-description">
                                <%= book.description %>
                            </p>
                        </div>

                        <hr class="section-divider">

                        <!-- Comments Section -->
                        <div class="comments-wrapper">
                            <h4 class="comments-header">
                                <i class="bi bi-chat-square-text"></i>
                                Comments
                                <span class="comment-count">(<%= comments.length %>)</span>
                            </h4>

                            <!-- Comment Form -->
                            <% if (isAuthenticated) { %>
                                <form method="POST" action="/library/book/<%= book._id %>/comment" class="comment-form">
                                    <div class="form-group">
                                        <textarea name="text" class="comment-input" rows="4"
                                            placeholder="Share your thoughts about this book..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn-submit-comment">
                                        <i class="bi bi-send-fill"></i>
                                        <span>Post Comment</span>
                                    </button>
                                </form>
                                <% } else { %>
                                    <div class="login-prompt">
                                        <i class="bi bi-info-circle"></i>
                                        <a href="/login">Login</a> to post comments and share your thoughts
                                    </div>
                                    <% } %>

                                        <!-- Comments List -->
                                        <div class="comments-list">
                                            <% if (comments && comments.length> 0) { %>
                                                <% comments.forEach(comment=> { %>
                                                    <div class="comment-card">
                                                        <div class="comment-header">
                                                            <div class="comment-user">
                                                                <div class="user-avatar">
                                                                    <i class="bi bi-person-circle"></i>
                                                                </div>
                                                                <div class="user-info">
                                                                    <h6 class="user-name">
                                                                        <%= comment.user.fullName %>
                                                                    </h6>
                                                                    <span class="comment-date">
                                                                        <i class="bi bi-clock"></i>
                                                                        <%= new
                                                                            Date(comment.createdAt).toLocaleDateString('en-US',
                                                                            { year: 'numeric' , month: 'short' ,
                                                                            day: 'numeric' }) %>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <p class="comment-text">
                                                            <%= comment.text %>
                                                        </p>
                                                    </div>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <div class="no-comments">
                                                                <i class="bi bi-chat"></i>
                                                                <p>No comments yet. Be the first to share your thoughts!
                                                                </p>
                                                            </div>
                                                            <% } %>
                                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* ==========================================
   BOOK DETAILS PAGE - EMBEDDED STYLES
   ========================================== */

        .book-details-page {
            min-height: calc(100vh - 200px);
            padding-bottom: 3rem;
            position: relative;
        }

        /* ==========================================
   ANIMATED BACKGROUND
   ========================================== */

        .details-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            overflow: hidden;
        }

        .bg-particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: rgba(1, 28, 64, 0.3);
            border-radius: 50%;
            animation: float-particle 15s infinite ease-in-out;
        }

        .bg-particle:nth-child(1) {
            left: 15%;
            animation-delay: 0s;
            animation-duration: 18s;
        }

        .bg-particle:nth-child(2) {
            left: 35%;
            animation-delay: -5s;
            animation-duration: 20s;
        }

        .bg-particle:nth-child(3) {
            left: 65%;
            animation-delay: -10s;
            animation-duration: 22s;
        }

        .bg-particle:nth-child(4) {
            left: 85%;
            animation-delay: -15s;
            animation-duration: 25s;
        }

        @keyframes float-particle {
            0% {
                transform: translateY(100vh) scale(0);
                opacity: 0;
            }

            10% {
                opacity: 1;
            }

            90% {
                opacity: 1;
            }

            100% {
                transform: translateY(-100px) scale(1);
                opacity: 0;
            }
        }

        .bg-wave {
            position: absolute;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(1, 28, 64, 0.02) 0%, transparent 70%);
            animation: wave-rotate 30s linear infinite;
        }

        .wave-1 {
            top: -50%;
            left: -50%;
            animation-duration: 35s;
        }

        .wave-2 {
            bottom: -50%;
            right: -50%;
            animation-duration: 40s;
            animation-direction: reverse;
        }

        @keyframes wave-rotate {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        /* Breadcrumb Section */
        .breadcrumb-section {
            background: white;
            padding: 1.5rem 0;
            box-shadow: 0 2px 10px rgba(1, 28, 64, 0.05);
            margin-bottom: 2rem;
            position: relative;
            z-index: 1;
        }

        .custom-breadcrumb {
            background: transparent;
            margin: 0;
            padding: 0;
        }

        .custom-breadcrumb .breadcrumb-item a {
            color: #023859;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .custom-breadcrumb .breadcrumb-item a:hover {
            color: #011C40;
            transform: translateX(3px);
        }

        .custom-breadcrumb .breadcrumb-item.active {
            color: #26658C;
            font-weight: 600;
        }

        /* ==========================================
   3D BOOK COVER - CLEAN DESIGN
   ========================================== */

        .book-sidebar {
            position: sticky;
            top: 100px;
            z-index: 1;
        }

        .book-3d-container {
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .book-3d-scene {
            perspective: 1500px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 3rem 1rem;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, transparent 70%);
        }

        .book-3d {
            position: relative;
            width: 240px;
            height: 340px;
            transform-style: preserve-3d;
            transform: rotateY(-15deg);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .book-3d:hover {
            transform: rotateY(-15deg) translateY(-20px) scale(1.05);
        }

        /* Book Back Cover */
        .book-back {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #000811, #011C40);
            border-radius: 3px 0 0 3px;
            transform: translateZ(-40px);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.5);
        }

        /* Book Spine */
        .book-spine {
            position: absolute;
            left: 0;
            top: 0;
            width: 40px;
            height: 100%;
            background: linear-gradient(to right,
                    #000811,
                    #011C40 30%,
                    #023859 50%,
                    #011C40 70%,
                    #000811);
            transform-origin: left center;
            transform: rotateY(-90deg);
            box-shadow: inset -3px 0 15px rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .spine-text {
            writing-mode: vertical-rl;
            text-orientation: mixed;
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-height: 300px;
        }

        /* Book Front Cover */
        .book-front {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #011C40, #023859, #26658C);
            border-radius: 3px;
            box-shadow:
                8px 8px 30px rgba(0, 0, 0, 0.4),
                inset 0 0 0 3px rgba(255, 255, 255, 0.1),
                inset 0 0 100px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .cover-texture {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image:
                repeating-linear-gradient(0deg,
                    rgba(255, 255, 255, 0.03) 0px,
                    transparent 1px,
                    transparent 2px,
                    rgba(255, 255, 255, 0.03) 3px),
                repeating-linear-gradient(90deg,
                    rgba(255, 255, 255, 0.03) 0px,
                    transparent 1px,
                    transparent 2px,
                    rgba(255, 255, 255, 0.03) 3px);
            opacity: 0.3;
        }

        .cover-design {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            padding: 2.5rem 2rem;
            z-index: 1;
        }

        .cover-header,
        .cover-footer {
            text-align: center;
        }

        .decorative-line {
            width: 60%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
            margin: 0 auto;
        }

        .cover-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .cover-title {
            font-size: 1.4rem;
            font-weight: 900;
            color: #ffffff;
            line-height: 1.3;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow:
                3px 3px 6px rgba(0, 0, 0, 0.5),
                0 0 15px rgba(0, 0, 0, 0.3);
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .cover-ornament {
            width: 60px;
            height: 60px;
            border: 3px solid rgba(255, 255, 255, 0.5);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 1rem auto;
            position: relative;
        }

        .cover-ornament::before {
            content: '';
            position: absolute;
            width: 70px;
            height: 70px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
        }

        .cover-ornament i {
            font-size: 1.8rem;
            color: rgba(255, 255, 255, 0.9);
        }

        .cover-author {
            font-size: 0.95rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.95);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 1rem 0 0;
        }

        .category-label {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.8);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-top: 0.5rem;
            display: inline-block;
        }

        .cover-shine {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg,
                    transparent 30%,
                    rgba(255, 255, 255, 0.1) 50%,
                    transparent 70%);
            transform: rotate(45deg);
            pointer-events: none;
        }

        /* Book Top */
        .book-top {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 40px;
            background: linear-gradient(to bottom, #023859, #011C40);
            transform-origin: top center;
            transform: rotateX(90deg);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.4);
        }

        /* Book Bottom */
        .book-bottom {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 40px;
            background: linear-gradient(to top, #000811, #011C40);
            transform-origin: bottom center;
            transform: rotateX(-90deg);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .btn-action {
            width: 100%;
            padding: 1rem 1.5rem;
            border: none;
            border-radius: 15px;
            font-weight: 600;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn-action::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn-action:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-action i {
            font-size: 1.2rem;
        }

        .btn-add {
            background: linear-gradient(135deg, #011C40, #023859);
            color: white;
            box-shadow: 0 4px 15px rgba(1, 28, 64, 0.3);
        }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(1, 28, 64, 0.4);
        }

        .btn-added {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }

        .btn-added:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
        }

        .btn-like {
            background: white;
            color: #dc3545;
            border: 2px solid #dc3545;
        }

        .btn-like:hover {
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
        }

        .btn-liked {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        }

        .btn-read {
            background: linear-gradient(135deg, #ffc107, #ff9800);
            color: #000;
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
        }

        .btn-read:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 193, 7, 0.4);
        }

        .btn-login {
            background: linear-gradient(135deg, #6c757d, #495057);
            color: white;
        }

        /* Book Stats Card */
        .book-stats-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 5px 20px rgba(1, 28, 64, 0.08);
        }

        .stats-title {
            font-size: 1rem;
            font-weight: 700;
            color: #011C40;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid #e9ecef;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 0;
            color: #495057;
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            color: #023859;
            transform: translateX(5px);
        }

        .stat-item i {
            font-size: 1.2rem;
            color: #023859;
        }

        /* Book Details Content */
        .book-details-content {
            animation: slideInRight 0.8s ease;
        }

        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .book-header {
            margin-bottom: 2rem;
        }

        .book-title-main {
            font-size: 2.5rem;
            font-weight: 700;
            color: #011C40;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .book-author {
            font-size: 1.2rem;
            color: #6c757d;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .book-author i {
            font-size: 1.5rem;
            color: #023859;
        }

        .book-badges {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .custom-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.2rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .category-badge {
            background: linear-gradient(135deg, rgba(1, 28, 64, 0.1), rgba(38, 101, 140, 0.1));
            color: #023859;
            border: 1px solid rgba(1, 28, 64, 0.2);
        }

        .likes-badge {
            background: linear-gradient(135deg, rgba(220, 53, 69, 0.1), rgba(220, 53, 69, 0.2));
            color: #dc3545;
            border: 1px solid rgba(220, 53, 69, 0.2);
        }

        .book-description-section {
            margin-bottom: 2rem;
        }

        .section-heading {
            font-size: 1.3rem;
            font-weight: 700;
            color: #011C40;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .section-heading i {
            color: #023859;
        }

        .book-description {
            font-size: 1.05rem;
